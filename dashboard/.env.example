# Sumber data dashboard:
#   mock = simulasi ESP32 di browser (untuk desain/demo tanpa hardware)
#   mqtt = data asli dari ESP32 lewat broker MQTT (WebSocket)
VITE_DATA_SOURCE=mock

# URL broker MQTT via WebSocket (browser tidak bisa pakai TCP 1883 langsung).
# HiveMQ Cloud : wss://<cluster-id>.s1.eu.hivemq.cloud:8884/mqtt
# EMQX Cloud   : wss://<deployment>.emqxsl.com:8084/mqtt
# Mosquitto lokal (listener websockets 9001): ws://localhost:9001
VITE_MQTT_URL=wss://broker.hivemq.com:8884/mqtt
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

# ID greenhouse, dipakai di topic: greenhouse/<id>/...
VITE_DEVICE_ID=ugs-greenhouse-1

# (Opsional) URL backend untuk riwayat grafik: GET <url>/api/history?hours=24
# Kosongkan jika backend belum ada; grafik akan terisi dari data live.
VITE_API_URL=

# Teks di header
VITE_GREENHOUSE_NAME=Greenhouse Utama
VITE_GREENHOUSE_LOCATION=Surakarta, Indonesia
